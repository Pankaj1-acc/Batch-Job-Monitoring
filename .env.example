# -----------------------------------------------------------------------
# D365 F&O Batch Job Monitoring Agent — Environment Variables
#
# Copy this file to .env and fill in your values.
# Never commit a .env file with real secrets to source control.
# -----------------------------------------------------------------------

# ---- Azure AD / OAuth2 ------------------------------------------------
# Tenant ID of your Azure Active Directory
AZURE_TENANT_ID=your-aad-tenant-id

# App Registration (Service Principal) credentials
AZURE_CLIENT_ID=your-app-registration-client-id
AZURE_CLIENT_SECRET=your-app-registration-client-secret

# ---- D365 F&O environment ---------------------------------------------
# Base URL of your D365 F&O environment (no trailing slash)
D365_URL=https://your-environment.operations.dynamics.com

# OAuth2 resource / scope base URL — usually the same as D365_URL
# Leave blank to default to D365_URL
D365_RESOURCE=

# ---- Monitoring settings ----------------------------------------------
# Comma-separated list of batch job statuses that should trigger alerts
# Defaults to: Error,Canceling,Canceled
ALERT_STATUSES=Error,Canceling,Canceled

# Number of records to request per OData page (default: 1000)
ODATA_PAGE_SIZE=1000

# ---- Email notifications (SMTP) ---------------------------------------
# Leave SMTP_HOST blank to disable email notifications
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=monitor@yourcompany.com
SMTP_PASSWORD=your-smtp-password

# From address used in alert emails (defaults to SMTP_USER if blank)
ALERT_SENDER=d365-monitor@yourcompany.com

# Comma-separated list of recipient email addresses
ALERT_RECIPIENTS=admin@yourcompany.com,ops-team@yourcompany.com

# ---- Microsoft Teams notifications ------------------------------------
# Incoming webhook URL for your Teams channel (leave blank to disable)
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...
